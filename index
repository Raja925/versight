}
function insertTable() { toast_show('Table inserted'); }
function insertPPEBlock() { toast_show('PPE block inserted at cursor position'); }

// ── Keyboard shortcuts (Ctrl+W/Q/A/F for image sizes) ──
document.addEventListener('keydown', e => {
  if(e.ctrlKey) {
    const map = {w:'small',q:'medium',a:'large',f:'full',
      '1':'verb_first','2':'split_actions','3':'add_units','4':'ppe_check','5':'safety_scan'};
    const k = e.key.toLowerCase();
    if(map[k] && Object.keys({w:1,q:1,a:1,f:1}).includes(k)) {
      e.preventDefault();
      alignImages(map[k]);
    }
    if(map[k] && ['1','2','3','4','5'].includes(k)) {
      e.preventDefault();
      runMacro(map[k]);
    }
  }
});

// ── Run macro (AI-powered) ──
async function runMacro(macroId) {
  const body = document.getElementById('doc-body');
  const text = body.innerText.trim();
  const prompts = {
    verb_first: `Review these SOP steps. List only the steps that don't start with an imperative verb. For each, give the step number and a corrected version. Be brief. Steps:\n${text}`,
    split_actions: `Review these SOP steps. Identify any step with multiple actions (joined by "and", "then", "also"). For each, show how to split into separate steps. Be brief. Steps:\n${text}`,
    add_units: `Review these SOP steps for numbers without measurement units. List each issue with a fix. Be brief. Steps:\n${text}`,
    ppe_check: `Review these SOP steps for PPE compliance. Note any hazardous task missing PPE mention. Be brief. Steps:\n${text}`,
    readability: `Rate the readability of these SOP steps (aim for Flesch ≥ 60). List the most complex sentences with simpler rewrites. Be brief. Steps:\n${text}`,
    safety_scan: `Scan these SOP steps for hazard keywords and recommend ANSI/ISO safety symbols to add. Be brief. Steps:\n${text}`
  };
  const prompt = prompts[macroId] || prompts.verb_first;
  switchAITab('chat');
  addChatMsg('bot', '<span class="spinner"></span> Running macro…');
  let resp = '';
  const last = () => document.getElementById('chat-messages').lastElementChild?.querySelector('span');
  try {
    const res = await fetch(API, {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({model:'claude-sonnet-4-6',max_tokens:600,stream:true,
        messages:[{role:'user',content:prompt}]})
    });
    if(last()) last().textContent = '';
    const reader = res.body.getReader();
    const dec = new TextDecoder();
    let buf = '';
    while(true) {
      const {done,value} = await reader.read();
      if(done) break;
      buf += dec.decode(value);
      const lines = buf.split('\n'); buf = lines.pop();
      for(const line of lines) {
        if(!line.startsWith('data: ')) continue;
        const d = line.slice(6).trim();
        if(d==='[DONE]') continue;
        try {
          const j = JSON.parse(d);
          if(j.type==='content_block_delta'&&j.delta?.text) {
            resp += j.delta.text;
            if(last()) last().textContent = resp;
          }
        } catch{}
      }
    }
  } catch(e) {
    if(last()) last().textContent = 'API error — check internet connection.';
  }
}

// ── AI full analysis ──
async function runAIAnalysis() {
  const body = document.getElementById('doc-body');
  const steps = body.querySelectorAll('.sop-step');
  const texts = Array.from(steps).map((s,i) => `${i+1}. ${s.querySelector('.step-content').innerText}`).join('\n');

  switchAITab('issues');
  const container = document.getElementById('aip-issues');
  container.innerHTML = '<div style="padding:20px;text-align:center;color:#888"><span class="spinner"></span> AI analyzing document…</div>';

  const prompt = `Analyze these SOP steps for quality issues. Return JSON only, no markdown:
{"issues":[{"step_index":0,"type":"passive|unit|multiple_actions|verb|ppe|length","description":"brief description","original":"original text","fix":"corrected version"}]}
Steps:\n${texts}`;

  let resp = '';
  try {
    const res = await fetch(API, {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({model:'claude-sonnet-4-6',max_tokens:800,stream:true,
        messages:[{role:'user',content:prompt}]})
    });
    const reader = res.body.getReader();
    const dec = new TextDecoder();
    let buf = '';
    while(true) {
      const {done,value} = await reader.read();
      if(done) break;
      buf += dec.decode(value);
      const lines = buf.split('\n'); buf = lines.pop();
      for(const line of lines) {
        if(!line.startsWith('data: ')) continue;
        const d = line.slice(6).trim();
        if(d==='[DONE]') continue;
        try {
          const j = JSON.parse(d);
          if(j.type==='content_block_delta'&&j.delta?.text) resp += j.delta.text;
        } catch{}
      }
    }
    const match = resp.match(/\{[\s\S]*\}/);
    if(match) {
      const data = JSON.parse(match[0]);
      renderIssueCards(data.issues, steps);
    } else throw new Error('no json');
  } catch(e) {
    renderIssueCards(null, steps);
  }
}

function renderIssueCards(issues, steps) {
  const container = document.getElementById('aip-issues');
  if(!issues || issues.length === 0) {
    container.innerHTML = '<div style="padding:20px;text-align:center;color:#1a7a40;font-weight:600">✅ All steps are compliant!</div>';
    updateScore(100, 0);
    return;
  }
  const typeColors = {
    passive: 'var(--flag-red-bg)|var(--flag-red)|Passive voice',
    verb: 'var(--flag-red-bg)|var(--flag-red)|Non-verb start',
    unit: 'var(--flag-amber-bg)|var(--flag-amber)|Missing unit',
    multiple_actions: 'var(--flag-amber-bg)|var(--flag-amber)|Multiple actions',
    ppe: 'var(--flag-amber-bg)|var(--flag-amber)|PPE missing',
    length: 'var(--flag-blue-bg)|var(--flag-blue)|Too long'
  };
  container.innerHTML = `<div style="font-size:11px;color:var(--text-muted);margin-bottom:10px">${issues.length} issue${issues.length!==1?'s':''} found · Click to highlight in document</div>`;
  issues.forEach((iss, i) => {
    const [bg,fg,label] = (typeColors[iss.type]||'var(--flag-blue-bg)|var(--flag-blue)|Issue').split('|');
    const card = document.createElement('div');
    card.className = 'issue-card';
    card.id = 'ic-ai-' + i;
    card.innerHTML = `
      <div class="ic-header">
        <span class="ic-type" style="background:${bg};color:${fg}">${label}</span>
        <span class="ic-line">Step ${iss.step_index+1}</span>
      </div>
      <div class="ic-original">${iss.original||iss.description}</div>
      ${iss.fix ? `<div class="ic-fix">✓ ${iss.fix}</div>` : ''}
      <div class="ic-actions">
        ${iss.fix ? `<button class="ic-btn ic-btn-accept" onclick="applyFixDirect(${iss.step_index},'${iss.fix.replace(/'/g,"\\'")}',${i})">Apply fix</button>` : ''}
        <button class="ic-btn ic-btn-skip" onclick="document.getElementById('ic-ai-${i}').classList.add('resolved')">Skip</button>
      </div>`;
    card.onclick = (e) => { if(!e.target.classList.contains('ic-btn')) highlightStep(iss.step_index); };
    container.appendChild(card);
  });
  const actRow = document.createElement('div');
  actRow.style.cssText = 'margin-top:12px;display:flex;gap:6px';
  actRow.innerHTML = `<button class="ic-btn ic-btn-accept" style="flex:1;padding:7px" onclick="acceptAllFixes()">✅ Accept all fixes</button><button class="ic-btn ic-btn-skip" onclick="runAIAnalysis()">🔄 Re-analyze</button>`;
  container.appendChild(actRow);
  const score = Math.round(((steps.length - issues.length) / steps.length) * 100);
  updateScore(score, issues.length);
}

function highlightStep(idx) {
  document.querySelectorAll('.sop-step').forEach(s => s.style.outline = '');
  const step = document.getElementById('step-' + idx);
  if(step) { step.style.outline = '2px solid #2b579a'; step.scrollIntoView({behavior:'smooth',block:'center'}); }
}

function applyFix(e, stepIdx, fixText) {
  e.stopPropagation();
  const step = document.getElementById('step-' + stepIdx);
  if(step) {
    step.querySelector('.step-content').innerText = fixText;
    step.className = 'sop-step flagged-fixed';
    const flag = step.querySelector('.step-inline-flag');
    if(flag) { flag.textContent = '✓ Fixed'; flag.style.background = 'var(--flag-green-bg)'; flag.style.color = 'var(--flag-green)'; }
  }
  e.target.closest('.issue-card').classList.add('resolved');
  recalcScore();
  toast_show('Fix applied ✓');
}

function applyFixDirect(stepIdx, fixText, cardIdx) {
  const step = document.getElementById('step-' + stepIdx);
  if(step) {
    step.querySelector('.step-content').innerText = fixText;
    step.className = 'sop-step flagged-fixed';
    const flag = step.querySelector('.step-inline-flag');
    if(flag) { flag.textContent = '✓'; flag.style.background = 'var(--flag-green-bg)'; flag.style.color = 'var(--flag-green)'; }
  }
  const card = document.getElementById('ic-ai-' + cardIdx);
  if(card) card.classList.add('resolved');
  recalcScore();
  toast_show('Fix applied ✓');
}

function applySplit(e) {
  e.stopPropagation();
  const step = document.getElementById('step-2');
  if(step) {
    step.querySelector('.step-content').innerText = 'Fill the cell with 45 mL of electrolyte.';
    step.className = 'sop-step flagged-fixed';
    const body = document.getElementById('doc-body');
    const s3 = document.createElement('div');
    s3.className = 'sop-step flagged-fixed';
    s3.innerHTML = '<div class="step-n">3b.</div><div class="step-content" contenteditable="true">Seal the fill port securely.</div><div class="step-inline-flag" style="background:var(--flag-green-bg);color:var(--flag-green)">✓</div>';
    const s4 = document.createElement('div');
    s4.className = 'sop-step flagged-fixed';
    s4.innerHTML = '<div class="step-n">3c.</div><div class="step-content" contenteditable="true">Torque the cap to 2.5 Nm using a calibrated torque wrench.</div><div class="step-inline-flag" style="background:var(--flag-green-bg);color:var(--flag-green)">✓</div>';
    step.after(s3); s3.after(s4);
    const flag = step.querySelector('.step-inline-flag');
    if(flag) { flag.textContent = '✓'; flag.style.background = 'var(--flag-green-bg)'; flag.style.color = 'var(--flag-green)'; }
  }
  e.target.closest('.issue-card').classList.add('resolved');
  recalcScore();
  toast_show('Step split into 3 separate actions ✓');
}

function skipFix(e, idx) {
  e.stopPropagation();
  e.target.closest('.issue-card').classList.add('resolved');
  toast_show('Issue skipped');
}

function acceptAllFixes() {
  document.querySelectorAll('.ic-btn-accept').forEach(b => { if(!b.closest('.issue-card').classList.contains('resolved')) b.click(); });
  toast_show('All fixes applied ✓');
}

function recalcScore() {
  const steps = document.querySelectorAll('.sop-step');
  const fixed = document.querySelectorAll('.sop-step.flagged-fixed, .sop-step:not(.flagged-red):not(.flagged-amber)').length;
  const pct = Math.round((fixed / steps.length) * 100);
  updateScore(pct, steps.length - fixed);
}

function updateScore(pct, issues) {
  document.getElementById('score-num').textContent = pct;
  const c = 125.7;
  document.getElementById('score-arc').setAttribute('stroke-dashoffset', c - (c * pct / 100));
  document.getElementById('score-arc').setAttribute('stroke', pct>=90?'#2dce7a':pct>=70?'#f5a623':'#e04040');
  document.getElementById('score-label').textContent = pct>=90?'Excellent':pct>=70?'Needs work':'Issues found';
  document.getElementById('score-sub').textContent = issues>0?`${issues} issue${issues!==1?'s':''} remaining`:'All issues resolved ✓';
  document.getElementById('sb-score').textContent = `Score: ${pct}%`;
  document.getElementById('sb-issues').textContent = issues>0?`${issues} issues`:'All clear ✓';
}

// ── Doc control generation ──
async function generateDocControl() {
  const body = document.getElementById('doc-body');
  const text = body.innerText.trim().substring(0,400);
  const prompt = `Write a concise document control change description (2 sentences max) for this manufacturing SOP change log. Factual, past tense, starts with what changed. Content: ${text}`;
  document.getElementById('dc-date').textContent = new Date().toISOString().split('T')[0];
  const desc = document.getElementById('dc-desc');
  desc.textContent = '';
  desc.style.color = '#1a7a40';
  try {
    const res = await fetch(API, {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({model:'claude-sonnet-4-6',max_tokens:200,stream:true,
        messages:[{role:'user',content:prompt}]})
    });
    const reader = res.body.getReader();
    const dec = new TextDecoder();
    let buf = '';
    while(true) {
      const {done,value} = await reader.read();
      if(done) break;
      buf += dec.decode(value);
      const lines = buf.split('\n'); buf = lines.pop();
      for(const line of lines) {
        if(!line.startsWith('data: ')) continue;
        const d = line.slice(6).trim();
        if(d==='[DONE]') continue;
        try {
          const j = JSON.parse(d);
          if(j.type==='content_block_delta'&&j.delta?.text) desc.textContent += j.delta.text;
        } catch{}
      }
    }
    toast_show('Document control table updated ✓');
  } catch(e) {
    desc.textContent = 'Initial release — electrolyte fill procedure for cell housing v1.0.';
  }
}

// ── AI Chat ──
function addChatMsg(role, html) {
  const msgs = document.getElementById('chat-messages');
  const div = document.createElement('div');
  div.className = `ai-msg ${role}`;
  div.innerHTML = `<span>${html}</span>`;
  msgs.appendChild(div);
  msgs.scrollTop = msgs.scrollHeight;
  return div.querySelector('span');
}

async function sendChat() {
  const input = document.getElementById('chat-input');
  const msg = input.value.trim();
  if(!msg) return;
  input.value = '';
  addChatMsg('user', msg);
  const body = document.getElementById('doc-body');
  const docText = body.innerText.trim().substring(0,600);
  const prompt = `You are an AI assistant for a manufacturing SOP editor. The document currently contains:\n\n${docText}\n\nUser request: ${msg}\n\nRespond concisely and practically. If suggesting edits, be specific about which step to change and the exact new text.`;
  const span = addChatMsg('bot', '<span class="spinner"></span>');
  let resp = '';
  try {
    const res = await fetch(API, {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({model:'claude-sonnet-4-6',max_tokens:400,stream:true,
        messages:[{role:'user',content:prompt}]})
    });
    span.innerHTML = '';
    const reader = res.body.getReader();
    const dec = new TextDecoder();
    let buf = '';
    while(true) {
      const {done,value} = await reader.read();
      if(done) break;
      buf += dec.decode(value);
      const lines = buf.split('\n'); buf = lines.pop();
      for(const line of lines) {
        if(!line.startsWith('data: ')) continue;
        const d = line.slice(6).trim();
        if(d==='[DONE]') continue;
        try {
          const j = JSON.parse(d);
          if(j.type==='content_block_delta'&&j.delta?.text) { resp += j.delta.text; span.textContent = resp; }
        } catch{}
      }
    }
  } catch(e) {
    span.textContent = 'API error — check your internet connection.';
  }
  document.getElementById('chat-messages').scrollTop = 9999;
}

// ── Settings ──
function openSettings(section) {
  document.getElementById('settings-overlay').classList.add('open');
  if(section) {
    const items = document.querySelectorAll('.snav-item');
    items.forEach(i => { if(i.textContent.toLowerCase().includes(section.replace('-',' '))) i.click(); });
  }
}
function closeSettings() { document.getElementById('settings-overlay').classList.remove('open'); }
function closeSettingsIfOutside(e) { if(e.target === document.getElementById('settings-overlay')) closeSettings(); }
function switchSettings(id, el) {
  document.querySelectorAll('.settings-section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.snav-item').forEach(i => i.classList.remove('active'));
  document.getElementById('ss-' + id).classList.add('active');
