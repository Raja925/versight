    result.textContent = 'Error generating prompt. Check internet connection.';
  }
}

async function generateMacroPrompt() {
  const desc = document.getElementById('new-macro-desc').value.trim();
  if(!desc) return;
  const out = document.getElementById('new-macro-prompt');
  out.value = 'Generating…';
  const prompt = `Write a concise AI prompt for a manufacturing SOP macro that does this: "${desc}". Use {text} as placeholder for SOP content. Output only the prompt, under 100 words.`;
  try {
    const res = await fetch(API, {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({model:'claude-sonnet-4-6',max_tokens:150,messages:[{role:'user',content:prompt}]})
    });
    const data = await res.json();
    out.value = data.content?.[0]?.text || 'Error';
    toast_show('Prompt generated ✓');
  } catch(e) { out.value = 'Error — check connection.'; }
}

