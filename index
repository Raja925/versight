<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Versight — SOP Editor</title>
<style>
:root {
  --ribbon-bg: #2b579a;
  --ribbon-tab-active: #ffffff;
  --ribbon-tab: rgba(255,255,255,0.15);
  --ribbon-text: #ffffff;
  --ribbon-hover: rgba(255,255,255,0.25);
  --toolbar-bg: #f3f3f3;
  --toolbar-border: #d4d4d4;
  --toolbar-hover: #e1e1e1;
  --toolbar-active: #d0d0d0;
  --page-bg: #e8e8e8;
  --doc-bg: #ffffff;
  --doc-shadow: 0 2px 12px rgba(0,0,0,0.18);
  --text-primary: #1a1a1a;
  --text-secondary: #444;
  --text-muted: #888;
  --ai-panel-bg: #fafbff;
  --ai-panel-border: #d8e0f0;
  --ai-accent: #2b579a;
  --ai-accent-light: #e8eef8;
  --flag-red-bg: #fde8e8; --flag-red: #c0392b;
  --flag-amber-bg: #fef3e2; --flag-amber: #d48000;
  --flag-green-bg: #e6f7ee; --flag-green: #1a7a40;
  --flag-blue-bg: #e8eef8; --flag-blue: #2b579a;
  --settings-bg: rgba(0,0,0,0.55);
  --macro-card: #f7f9ff;
  --macro-border: #c8d4ec;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; font-family: 'Segoe UI', system-ui, sans-serif; background: var(--page-bg); font-size: 13px; color: var(--text-primary); }

/* ── App shell ── */
.app-shell { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }

/* ── Title bar ── */
.title-bar { background: var(--ribbon-bg); color: white; display: flex; align-items: center; height: 30px; padding: 0 12px; gap: 10px; font-size: 12px; user-select: none; }
.title-bar-name { font-weight: 600; font-size: 13px; }
.title-bar-doc { color: rgba(255,255,255,0.75); }
.title-bar-actions { margin-left: auto; display: flex; gap: 6px; }
.tba { background: transparent; border: none; color: white; font-size: 12px; padding: 4px 10px; border-radius: 3px; cursor: pointer; font-family: inherit; }
.tba:hover { background: rgba(255,255,255,0.2); }
.tba.primary { background: rgba(255,255,255,0.25); font-weight: 600; }

/* ── Ribbon tabs ── */
.ribbon-tabs { background: var(--ribbon-bg); display: flex; padding: 0 8px; border-bottom: 2px solid rgba(255,255,255,0.15); }
.rtab { color: rgba(255,255,255,0.8); font-size: 12px; padding: 6px 14px; cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -2px; transition: all .12s; user-select: none; }
.rtab:hover { color: white; background: rgba(255,255,255,0.1); }
.rtab.active { color: white; background: var(--toolbar-bg); color: var(--text-primary); border-bottom-color: var(--toolbar-bg); font-weight: 600; }

/* ── Ribbon toolbar ── */
.ribbon { background: var(--toolbar-bg); border-bottom: 1px solid var(--toolbar-border); display: flex; align-items: stretch; padding: 4px 8px; gap: 2px; min-height: 72px; overflow-x: auto; }
.ribbon-group { display: flex; flex-direction: column; border-right: 1px solid var(--toolbar-border); padding: 0 8px 0 4px; margin-right: 4px; min-width: fit-content; }
.ribbon-group:last-child { border-right: none; }
.rg-label { font-size: 10px; color: var(--text-muted); text-align: center; margin-top: auto; padding-top: 3px; user-select: none; }
.rg-body { display: flex; gap: 2px; align-items: center; flex: 1; padding: 2px 0; }

/* Ribbon buttons */
.rbtn { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; padding: 4px 6px; border: 1px solid transparent; border-radius: 3px; cursor: pointer; background: transparent; font-family: inherit; font-size: 11px; color: var(--text-secondary); min-width: 40px; height: 52px; transition: all .1s; user-select: none; white-space: nowrap; }
.rbtn:hover { background: var(--toolbar-hover); border-color: var(--toolbar-border); }
.rbtn:active, .rbtn.active { background: var(--toolbar-active); border-color: #b0b0b0; }
.rbtn .icon { font-size: 18px; line-height: 1; }
.rbtn.small { flex-direction: row; height: 26px; min-width: auto; padding: 3px 8px; gap: 5px; font-size: 12px; }
.rbtn.small .icon { font-size: 14px; }
.rg-small-col { display: flex; flex-direction: column; gap: 2px; }

/* Heading selector */
.heading-select { height: 24px; border: 1px solid var(--toolbar-border); background: white; font-size: 12px; padding: 2px 4px; border-radius: 3px; cursor: pointer; font-family: inherit; }
.font-size-select { width: 48px; height: 24px; border: 1px solid var(--toolbar-border); background: white; font-size: 12px; padding: 2px 2px; border-radius: 3px; font-family: inherit; }

/* Image size shortcut badges */
.kb-badge { background: var(--ai-accent); color: white; font-size: 10px; font-weight: 700; padding: 1px 5px; border-radius: 3px; font-family: monospace; }

/* ── Status bar ── */
.status-bar { background: var(--ribbon-bg); color: rgba(255,255,255,0.85); font-size: 11px; height: 22px; display: flex; align-items: center; padding: 0 12px; gap: 16px; flex-shrink: 0; }
.sb-item { display: flex; align-items: center; gap: 4px; }
.sb-dot { width: 6px; height: 6px; border-radius: 50%; }

/* ── Editor layout ── */
.editor-layout { display: flex; flex: 1; overflow: hidden; }
.doc-canvas { flex: 1; overflow-y: auto; background: var(--page-bg); padding: 24px; display: flex; justify-content: center; align-items: flex-start; }
.doc-page { background: var(--doc-bg); box-shadow: var(--doc-shadow); width: 794px; min-height: 1000px; padding: 72px 80px; position: relative; flex-shrink: 0; }

/* ── AI panel ── */
.ai-panel { width: 300px; background: var(--ai-panel-bg); border-left: 1px solid var(--ai-panel-border); display: flex; flex-direction: column; overflow: hidden; flex-shrink: 0; }
.ai-panel-tabs { display: flex; border-bottom: 1px solid var(--ai-panel-border); }
.apt { flex: 1; padding: 8px 4px; font-size: 11px; font-weight: 600; text-align: center; cursor: pointer; color: var(--text-muted); border-bottom: 2px solid transparent; transition: all .12s; }
.apt.active { color: var(--ai-accent); border-bottom-color: var(--ai-accent); }
.apt:hover { background: var(--ai-accent-light); }
.ai-panel-body { flex: 1; overflow-y: auto; padding: 12px; }

/* AI issue cards */
.issue-card { background: white; border: 1px solid var(--ai-panel-border); border-radius: 6px; padding: 10px 12px; margin-bottom: 8px; cursor: pointer; transition: border-color .12s; }
.issue-card:hover { border-color: var(--ai-accent); }
.issue-card.resolved { opacity: .5; }
.ic-header { display: flex; align-items: center; gap: 6px; margin-bottom: 6px; }
.ic-type { font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 10px; text-transform: uppercase; letter-spacing: .05em; }
.ic-line { font-size: 10px; color: var(--text-muted); margin-left: auto; }
.ic-original { font-size: 12px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 6px; border-left: 3px solid #e0e0e0; padding-left: 7px; }
.ic-fix { font-size: 12px; color: var(--flag-green); line-height: 1.5; border-left: 3px solid var(--flag-green); padding-left: 7px; margin-bottom: 8px; }
.ic-actions { display: flex; gap: 5px; }
.ic-btn { font-size: 11px; padding: 3px 10px; border-radius: 4px; border: 1px solid; cursor: pointer; font-family: inherit; transition: all .1s; }
.ic-btn-accept { background: var(--flag-green-bg); color: var(--flag-green); border-color: var(--flag-green); }
.ic-btn-accept:hover { background: var(--flag-green); color: white; }
.ic-btn-skip { background: white; color: var(--text-muted); border-color: #ddd; }
.ic-btn-skip:hover { background: #f0f0f0; }

/* Score ring in AI panel */
.score-row { display: flex; align-items: center; gap: 12px; background: white; border: 1px solid var(--ai-panel-border); border-radius: 6px; padding: 10px 12px; margin-bottom: 10px; }
.score-mini { position: relative; width: 52px; height: 52px; flex-shrink: 0; }
.score-mini svg { transform: rotate(-90deg); }
.score-mini-num { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); font-size: 14px; font-weight: 700; }
.score-detail { flex: 1; }
.score-title { font-size: 13px; font-weight: 600; color: var(--text-primary); }
.score-sub { font-size: 11px; color: var(--text-muted); margin-top: 2px; }

/* AI chat in panel */
.ai-chat-input { padding: 10px; border-top: 1px solid var(--ai-panel-border); display: flex; gap: 6px; background: white; }
.ai-chat-input input { flex: 1; border: 1px solid var(--ai-panel-border); border-radius: 4px; padding: 6px 9px; font-size: 12px; font-family: inherit; outline: none; }
.ai-chat-input input:focus { border-color: var(--ai-accent); }
.ai-send-btn { background: var(--ai-accent); color: white; border: none; border-radius: 4px; padding: 6px 10px; cursor: pointer; font-size: 13px; }

.ai-msg { margin-bottom: 10px; font-size: 12px; line-height: 1.6; }
.ai-msg.user { text-align: right; }
.ai-msg.user span { background: var(--ai-accent); color: white; padding: 6px 10px; border-radius: 10px 10px 2px 10px; display: inline-block; }
.ai-msg.bot span { background: white; border: 1px solid var(--ai-panel-border); padding: 7px 10px; border-radius: 2px 10px 10px 10px; display: inline-block; color: var(--text-secondary); }

/* ── Document content styles ── */
.doc-header-block { border-bottom: 2px solid #2b579a; margin-bottom: 20px; padding-bottom: 12px; }
.doc-title-field { font-size: 18px; font-weight: 700; color: #1a1a1a; margin-bottom: 4px; }
.doc-meta-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 6px; font-size: 11px; margin-top: 8px; }
.doc-meta-item { display: flex; flex-direction: column; gap: 1px; }
.dm-label { color: var(--text-muted); font-size: 10px; text-transform: uppercase; letter-spacing: .05em; }
.dm-value { font-weight: 600; color: var(--text-primary); }
.dm-value.valid { color: var(--flag-green); }
.dm-value.warn { color: var(--flag-amber); }

/* PPE block */
.ppe-block { background: #fff8e1; border: 1px solid #f0c040; border-radius: 4px; padding: 10px 14px; margin-bottom: 16px; display: flex; gap: 10px; align-items: flex-start; }
.ppe-icon { font-size: 20px; flex-shrink: 0; }
.ppe-text { font-size: 12px; }
.ppe-title { font-weight: 700; color: #7a5000; margin-bottom: 2px; font-size: 11px; text-transform: uppercase; }
.ppe-items { color: #5a3a00; line-height: 1.6; }

/* Editable doc body */
.doc-body { outline: none; min-height: 400px; }
.doc-body:focus { outline: none; }

/* Step rows in doc */
.sop-step { display: flex; gap: 10px; margin-bottom: 4px; padding: 3px 4px; border-radius: 3px; transition: background .1s; position: relative; }
.sop-step:hover { background: #f5f7ff; }
.sop-step.flagged-red { background: var(--flag-red-bg); }
.sop-step.flagged-amber { background: var(--flag-amber-bg); }
.sop-step.flagged-fixed { background: var(--flag-green-bg); }
.step-n { min-width: 20px; color: var(--text-muted); font-size: 12px; user-select: none; padding-top: 1px; }
.step-content { flex: 1; font-size: 13px; line-height: 1.6; outline: none; }
.step-inline-flag { position: absolute; right: 6px; top: 4px; font-size: 10px; font-weight: 600; padding: 1px 6px; border-radius: 8px; pointer-events: none; }

/* Section headings */
.h1 { font-size: 16px; font-weight: 700; color: #2b579a; border-bottom: 1px solid #2b579a; padding-bottom: 4px; margin: 18px 0 8px; }
.h2 { font-size: 14px; font-weight: 700; color: #2b579a; margin: 14px 0 6px; }
.h3 { font-size: 13px; font-weight: 600; color: var(--text-primary); margin: 10px 0 4px; }
.h4 { font-size: 12px; font-weight: 600; color: var(--text-secondary); margin: 8px 0 3px; }

/* Safety callout */
.safety-callout { border: 1px solid; border-radius: 4px; padding: 8px 12px; margin: 10px 0; display: flex; gap: 10px; align-items: flex-start; }
.safety-callout.caution { border-color: #f0c040; background: #fffbe6; }
.safety-callout.warning { border-color: #e07000; background: #fff3e0; }
.safety-callout.danger { border-color: #c0392b; background: #fde8e8; }
.sc-icon { font-size: 18px; flex-shrink: 0; }
.sc-label { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
.caution .sc-label { color: #8a6000; }
.warning .sc-label { color: #7a3a00; }
.danger .sc-label { color: #8a1010; }
.sc-text { font-size: 12px; color: var(--text-secondary); margin-top: 2px; line-height: 1.5; }

/* Doc control table */
.dc-table { width: 100%; border-collapse: collapse; font-size: 11px; margin-top: 24px; border: 1px solid #ccc; }
.dc-table th { background: #2b579a; color: white; padding: 6px 10px; text-align: left; font-size: 10px; text-transform: uppercase; letter-spacing: .05em; }
.dc-table td { padding: 7px 10px; border: 1px solid #ddd; color: var(--text-secondary); vertical-align: top; }
.dc-table td.ai-gen { color: var(--flag-green); font-style: italic; }

/* Image placeholder */
.img-placeholder { background: #f0f2f8; border: 2px dashed #b0b8d0; border-radius: 4px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px; margin: 10px 0; color: var(--text-muted); font-size: 12px; cursor: pointer; transition: border-color .15s; min-height: 120px; }
.img-placeholder:hover { border-color: var(--ai-accent); color: var(--ai-accent); }
.img-placeholder .ip-icon { font-size: 28px; margin-bottom: 6px; }
.img-callout-row { display: flex; gap: 6px; flex-wrap: wrap; margin: 4px 0 8px; }
.img-callout-tag { font-size: 11px; padding: 2px 8px; border: 1px dashed #f5c000; background: #fffbe6; border-radius: 3px; color: #7a5000; cursor: pointer; }
.img-callout-tag:hover { background: #f5c000; color: white; }

/* ── Settings modal ── */
.settings-overlay { position: fixed; inset: 0; background: var(--settings-bg); z-index: 1000; display: none; align-items: center; justify-content: center; }
.settings-overlay.open { display: flex; }
.settings-modal { background: white; border-radius: 8px; width: 720px; max-height: 85vh; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 8px 40px rgba(0,0,0,0.3); }
.settings-header { background: var(--ribbon-bg); color: white; padding: 14px 20px; display: flex; align-items: center; gap: 10px; }
.settings-header h2 { font-size: 15px; font-weight: 600; flex: 1; }
.settings-close { background: transparent; border: none; color: white; font-size: 20px; cursor: pointer; padding: 0 4px; line-height: 1; }
.settings-body { display: flex; flex: 1; overflow: hidden; }
.settings-nav { width: 180px; background: #f5f5f5; border-right: 1px solid #e0e0e0; padding: 12px 0; flex-shrink: 0; }
.snav-item { padding: 8px 16px; font-size: 13px; color: var(--text-secondary); cursor: pointer; border-left: 3px solid transparent; transition: all .1s; }
.snav-item:hover { background: #eaeaea; color: var(--text-primary); }
.snav-item.active { color: var(--ai-accent); background: var(--ai-accent-light); border-left-color: var(--ai-accent); font-weight: 600; }
.settings-content { flex: 1; overflow-y: auto; padding: 20px; }
.settings-section { display: none; }
.settings-section.active { display: block; }
.ss-title { font-size: 14px; font-weight: 700; color: var(--text-primary); margin-bottom: 4px; }
.ss-sub { font-size: 12px; color: var(--text-muted); margin-bottom: 16px; }

/* Macro cards */
.macro-card { background: var(--macro-card); border: 1px solid var(--macro-border); border-radius: 6px; padding: 12px 14px; margin-bottom: 10px; }
.mc-header { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
.mc-key { font-family: monospace; font-size: 12px; font-weight: 700; background: #2b579a; color: white; padding: 2px 8px; border-radius: 4px; }
.mc-name { font-size: 13px; font-weight: 600; color: var(--text-primary); }
.mc-desc { font-size: 12px; color: var(--text-secondary); margin-bottom: 8px; line-height: 1.5; }
.mc-prompt { font-size: 11px; background: white; border: 1px solid var(--macro-border); border-radius: 4px; padding: 7px 10px; color: var(--text-secondary); line-height: 1.5; font-family: monospace; }
.mc-edit-btn { font-size: 11px; padding: 3px 10px; border-radius: 4px; border: 1px solid var(--macro-border); background: white; color: var(--ai-accent); cursor: pointer; margin-left: auto; }
.mc-edit-btn:hover { background: var(--ai-accent); color: white; }

/* Prompt editor in settings */
.prompt-editor { width: 100%; border: 1px solid var(--macro-border); border-radius: 4px; padding: 8px 10px; font-size: 12px; font-family: monospace; resize: vertical; min-height: 80px; color: var(--text-primary); outline: none; }
.prompt-editor:focus { border-color: var(--ai-accent); }
label { font-size: 12px; font-weight: 600; color: var(--text-secondary); display: block; margin-bottom: 4px; }
input[type="text"], select { width: 100%; border: 1px solid var(--macro-border); border-radius: 4px; padding: 6px 9px; font-size: 12px; font-family: inherit; outline: none; color: var(--text-primary); background: white; }
input[type="text"]:focus, select:focus { border-color: var(--ai-accent); }
.form-row-s { margin-bottom: 12px; }
.save-btn { background: var(--ai-accent); color: white; border: none; border-radius: 4px; padding: 8px 18px; font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit; }
.save-btn:hover { background: #1e4080; }

/* AI prompt bar at bottom of settings macro */
.ai-macro-create { background: var(--ai-accent-light); border: 1px solid var(--macro-border); border-radius: 6px; padding: 12px 14px; margin-top: 14px; }
.amc-label { font-size: 12px; font-weight: 600; color: var(--ai-accent); margin-bottom: 6px; }
.amc-row { display: flex; gap: 6px; }
.amc-input { flex: 1; border: 1px solid var(--macro-border); border-radius: 4px; padding: 7px 10px; font-size: 12px; font-family: inherit; outline: none; }
.amc-input:focus { border-color: var(--ai-accent); }
.amc-btn { background: var(--ai-accent); color: white; border: none; border-radius: 4px; padding: 7px 14px; font-size: 12px; cursor: pointer; font-family: inherit; white-space: nowrap; }
.amc-result { margin-top: 10px; font-size: 12px; color: var(--text-secondary); background: white; border: 1px solid var(--macro-border); border-radius: 4px; padding: 8px 10px; min-height: 40px; line-height: 1.6; display: none; }

/* ── Misc ── */
.spinner { display: inline-block; width: 13px; height: 13px; border: 2px solid #ccc; border-top-color: var(--ai-accent); border-radius: 50%; animation: spin .6s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.toast { position: fixed; bottom: 28px; left: 50%; transform: translateX(-50%) translateY(10px); background: #2b579a; color: white; padding: 9px 20px; border-radius: 20px; font-size: 13px; font-weight: 500; opacity: 0; transition: all .25s; z-index: 2000; pointer-events: none; }
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
.divider-line { border: none; border-top: 1px solid #e8e8e8; margin: 14px 0; }
::-webkit-scrollbar { width: 5px; height: 5px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: #ccc; border-radius: 3px; }
.badge-pill { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; font-weight: 600; padding: 2px 7px; border-radius: 10px; }
.bp-green { background: var(--flag-green-bg); color: var(--flag-green); }
.bp-amber { background: var(--flag-amber-bg); color: var(--flag-amber); }
.bp-red { background: var(--flag-red-bg); color: var(--flag-red); }
.bp-blue { background: var(--flag-blue-bg); color: var(--flag-blue); }
</style>
</head>
<body>
<div class="app-shell">

  <!-- Title bar -->
  <div class="title-bar">
    <div class="title-bar-name">Versight</div>
    <div style="color:rgba(255,255,255,0.5)">·</div>
    <div class="title-bar-doc" id="tbar-docname">MFG-CELL-WI-0041 · Electrolyte fill and seal procedure</div>
    <div class="title-bar-actions">
      <button class="tba" onclick="openSettings()">⚙ Macros & Settings</button>
      <button class="tba" onclick="runAIAnalysis()">⚡ AI Analyze</button>
      <button class="tba primary" onclick="toast_show('Document saved to SVN draft folder ✓')">💾 Save</button>
    </div>
  </div>

  <!-- Ribbon tabs -->
  <div class="ribbon-tabs">
    <div class="rtab active" onclick="switchRibbon('home',this)">Home</div>
    <div class="rtab" onclick="switchRibbon('insert',this)">Insert</div>
    <div class="rtab" onclick="switchRibbon('format',this)">Format</div>
    <div class="rtab" onclick="switchRibbon('macros',this)">Macros</div>
    <div class="rtab" onclick="switchRibbon('safety',this)">Safety</div>
    <div class="rtab" onclick="switchRibbon('review',this)">Review</div>
  </div>

  <!-- Ribbon toolbars -->
  <div class="ribbon" id="ribbon-home">
    <div class="ribbon-group">
      <div class="rg-body">
        <select class="heading-select" id="heading-sel" onchange="applyHeading(this.value)" title="Heading level">
          <option value="body">Body text</option>
          <option value="h1">Heading 1</option>
          <option value="h2">Heading 2</option>
          <option value="h3">Heading 3</option>
          <option value="h4">Heading 4</option>
        </select>
        <select class="font-size-select" title="Font size">
          <option>11</option><option selected>13</option><option>14</option><option>16</option><option>18</option>
        </select>
      </div>
      <div class="rg-label">Paragraph</div>
    </div>
    <div class="ribbon-group">
      <div class="rg-body">
        <button class="rbtn small" onclick="fmt('bold')" title="Bold"><span class="icon">𝐁</span> Bold</button>
        <button class="rbtn small" onclick="fmt('italic')" title="Italic"><span class="icon"><i>I</i></span> Italic</button>
        <button class="rbtn small" onclick="fmt('underline')" title="Underline"><span class="icon"><u>U</u></span> Underline</button>
        <button class="rbtn small" onclick="insertList()" title="Numbered list"><span class="icon">≡</span> List</button>
      </div>
