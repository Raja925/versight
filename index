<script>
const API = 'https://api.anthropic.com/v1/messages';

// ── Ribbon switching ──
function switchRibbon(id, el) {
  document.querySelectorAll('[id^="ribbon-"]').forEach(r => r.style.display = 'none');
  document.getElementById('ribbon-' + id).style.display = 'flex';
  document.querySelectorAll('.rtab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
}

// ── AI panel tabs ──
function switchAITab(tab) {
  ['issues','score'].forEach(t => {
    const el = document.getElementById('aip-' + t);
    if(el) el.style.display = 'none';
  });
  const chatWrap = document.getElementById('aip-chat-wrap');
  if(chatWrap) chatWrap.style.display = 'none';
  document.querySelectorAll('.apt').forEach(a => a.classList.remove('active'));
  document.getElementById('apt-' + tab).classList.add('active');

  if(tab === 'chat') {
    const cw = document.getElementById('aip-chat-wrap');
    cw.style.display = 'flex';
    cw.style.flexDirection = 'column';
    cw.style.flex = '1';
    cw.style.overflow = 'hidden';
  } else {
    document.getElementById('aip-' + tab).style.display = 'block';
  }
}

// ── Heading apply ──
function applyHeading(level) {
  const sel = window.getSelection();
  if (!sel.rangeCount) return;
  const range = sel.getRangeAt(0);
  const el = range.commonAncestorContainer.parentElement;
  const classMap = { h1:'h1', h2:'h2', h3:'h3', h4:'h4', body:'' };
  if(el && el.closest('.doc-page')) {
    el.className = classMap[level] || '';
  }
  document.getElementById('heading-sel').value = level;
  toast_show(`Heading ${level} applied`);
}

// ── Format commands ──
function fmt(cmd) {
  document.execCommand(cmd);
}
function insertList() {
  document.execCommand('insertOrderedList');
}

// ── Insert step ──
function insertStep() {
  const body = document.getElementById('doc-body');
  const steps = body.querySelectorAll('.sop-step');
  const n = steps.length + 1;
  const div = document.createElement('div');
  div.className = 'sop-step';
  div.id = 'step-' + (n-1);
  div.innerHTML = `<div class="step-n">${n}.</div><div class="step-content" contenteditable="true">New step — type instruction here.</div>`;
  body.appendChild(div);
  div.querySelector('.step-content').focus();
  toast_show('Step ' + n + ' added');
}

// ── Safety callout ──
function insertSafetyCallout(type) {
  const icons = { caution:'⚠️', warning:'🔶', danger:'🚫' };
  const labels = { caution:'CAUTION', warning:'WARNING', danger:'DANGER' };
  const texts = {
    caution:'Ensure all PPE is worn and the area is clear before proceeding.',
    warning:'Failure to follow this procedure may result in equipment damage or injury.',
    danger:'Risk of serious injury or death. Do not proceed until all conditions are met.'
  };
  const body = document.getElementById('doc-body');
  const div = document.createElement('div');
  div.className = `safety-callout ${type}`;
  div.innerHTML = `<div class="sc-icon">${icons[type]}</div><div><div class="sc-label">${labels[type]}</div><div class="sc-text" contenteditable="true">${texts[type]}</div></div>`;
  const lastStep = body.querySelector('.sop-step:last-child');
  if(lastStep) body.insertBefore(div, lastStep.nextSibling);
  else body.appendChild(div);
  toast_show(labels[type] + ' callout inserted');
}

// ── Safety symbol ──
function insertSafetySymbol(type) {
  const map = {electric:'⚡ Electric hazard',cut:'✂️ Cut hazard',chemical:'🧪 Chemical hazard',hot:'🔥 Hot surface',pinch:'🤏 Pinch point',esd:'🛡️ ESD sensitive',laser:'🔴 Laser hazard',pressure:'💨 Pressure hazard',fall:'🪜 Fall risk',crush:'⚙️ Crush hazard'};
  toast_show(map[type] + ' symbol inserted before selected step');
}

// ── Image controls ──
function insertImagePlaceholder() {
