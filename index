}

// ── Create macro from prompt ──
async function createMacroFromPrompt() {
  const desc = document.getElementById('macro-create-input').value.trim();
  if(!desc) return;
  const result = document.getElementById('amc-result');
  result.style.display = 'block';
  result.textContent = '';
  const prompt = `Write a concise AI prompt for a manufacturing SOP macro that does this: "${desc}". The prompt should use {text} as a placeholder for the SOP content. Output only the prompt text, nothing else. Keep it under 100 words.`;
  try {
    const res = await fetch(API, {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({model:'claude-sonnet-4-6',max_tokens:150,stream:true,
        messages:[{role:'user',content:prompt}]})
    });
    const reader = res.body.getReader();
    const dec = new TextDecoder();
    let buf = '';
    while(true) {
      const {done,value} = await reader.read();
      if(done) break;
      buf += dec.decode(value);
      const lines = buf.split('\n'); buf = lines.pop();
      for(const line of lines) {
        if(!line.startsWith('data: ')) continue;
        const d = line.slice(6).trim();
        if(d==='[DONE]') continue;
        try {
          const j = JSON.parse(d);
          if(j.type==='content_block_delta'&&j.delta?.text) result.textContent += j.delta.text;
        } catch{}
      }
    }
    toast_show('Macro prompt generated ✓ — click Save macro to add it');
