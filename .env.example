# Copy this file to .env and fill in the key. .env is git-ignored. Never commit a real key.

# Required for the AI assistant and style learning (get one at https://platform.claude.com).
# This is an API key, separate from a claude.ai chat subscription.
ANTHROPIC_API_KEY=

# Optional. Defaults shown.
# VERSIGHT_MODEL=claude-sonnet-5-5
# VERSIGHT_EFFORT=medium        # low | medium | high | xhigh | max  (higher = slower and costlier)
# VERSIGHT_MAX_TOKENS=16000     # room for the answer plus the model's internal thinking
# VERSIGHT_TIMEOUT=240          # seconds to wait for one model call
# VERSIGHT_MAX_RETRIES=2
# VERSIGHT_HOST=127.0.0.1       # keep this local; the server has no login
# VERSIGHT_PORT=8000
# VERSIGHT_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]   # Host headers the server accepts
# VERSIGHT_MAX_BODY_BYTES=4194304

# Run without any model (canned answers from simple rules, for trying the editor or testing):
# VERSIGHT_MOCK=1
